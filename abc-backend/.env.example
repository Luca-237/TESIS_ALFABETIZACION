# ─── Backend FitoABC — Variables de Entorno ──────────────────────

# Puerto donde ejecuta el servidor
PORT=3000

# URL del frontend permitida para CORS
FRONTEND_URL=http://localhost:5173

# Usar autenticación mock (true) para desarrollo o Clerk real (false) para producción
USE_MOCK_AUTH=true

# MongoDB Atlas — cadena de conexión al cluster
MONGO_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/fitoabc?retryWrites=true&w=majority

# Clerk Auth — secreto del webhook (requerido si USE_MOCK_AUTH=false)
# CLERK_WEBHOOK_SECRET=whsec_tu_secreto_aqui
